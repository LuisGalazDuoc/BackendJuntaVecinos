# Cambiar nombre .env para funcionar

# Clave HMAC para firmar y validar los JWT (minimo 32 caracteres)
SECRET=la_super_secreta_clave_secreta_de_todas_las_claves

# Duracion del token de usuario en minutos
JWT_EXPIRATION_MINUTES=60

# Usuario de MySQL que usan los microservicios
MYSQL_USER=juntavecinos
MYSQL_PASSWORD=la_clave_para_mysql
MYSQL_ROOT_PASSWORD=la_clave_para_mysql_root
